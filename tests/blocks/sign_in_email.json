{
  "id": "sign_in_email",
  "label": "Sign in with email",
  "category": "auth",
  "description": "Fallback email/password sign-in path using env placeholders, then assert the login screen is gone.",
  "mermaid_label": "Sign in with email",
  "mermaid_snippet": "auth[\"Sign in with email\"]",
  "status": "repo",
  "appium_commands": [
    {
      "type": "dismiss_alert",
      "optional": true
    },
    {
      "type": "wait_for_source_contains",
      "timeout_ms": 30000,
      "expected": "Email address"
    },
    {
      "type": "type",
      "using": "accessibility id",
      "value": "oasiz-login-email",
      "text": "env:OASIZ_TEST_EMAIL",
      "clear": true
    },
    {
      "type": "wait",
      "ms": 3000
    },
    {
      "type": "wait_for_source_contains",
      "timeout_ms": 10000,
      "expected": "Switch to sign in",
      "optional": true
    },
    {
      "type": "find_and_tap",
      "using": "xpath",
      "value": "//*[@label=\"Switch to sign in\" or @name=\"Switch to sign in\"]",
      "optional": true
    },
    {
      "type": "wait",
      "ms": 1000
    },
    {
      "type": "wait_for_source_contains",
      "timeout_ms": 10000,
      "expected": "Forgot Password?"
    },
    {
      "type": "type",
      "using": "accessibility id",
      "value": "oasiz-login-password",
      "text": "env:OASIZ_TEST_PASSWORD",
      "clear": true
    },
    {
      "type": "find_and_tap",
      "using": "accessibility id",
      "value": "oasiz-login-submit"
    },
    {
      "type": "wait",
      "ms": 5000
    },
    {
      "type": "assert_signed_in"
    }
  ]
}
